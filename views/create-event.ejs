<!DOCTYPE html>
<html lang="en">

<head>
    <title>Picky</title>
    <!-- <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css"> -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.sand.min.css">
</head>

<body>
    <h2>Create your Event</h2>
    <form action="<%= event ? `/event/${event._id}/edit` : '/events/create' %>" method="POST">
        <input value="<%= event? event.name : '' %>" type="text" placeholder="Event Name" name="eventName">
        <input value="<%= event? event.date : '' %>" type="date" name="eventDate">
        <input type="time" name="eventTime">

        <select name="eventType" id="eventType">
            <option value="">--Please choose an option--</option>
            <option value="breakfast">Breakfast</option>
            <option value="brunch">Brunch</option>
            <option value="lunch">Lunch</option>
            <option value="dinner">Dinner</option>
            <option value="sweetTreat">Sweet Treat</option>
        </select>

        <input type="submit">
    </form>
</body>

</html>